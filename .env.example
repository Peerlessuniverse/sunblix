# ============================================================================
# SUNBLIX ENVIRONMENT CONFIGURATION TEMPLATE
# PT SUNBLIX ENERGI INDONESIA
# ============================================================================
# IMPORTANT:
# 1. Do NOT put production secrets in this file.
# 2. Never commit actual credentials to version control.
# 3. Rotate any credentials previously exposed immediately.
# ============================================================================

# --- 1. INTERNAL STAFF AUTHENTICATION ---
# Mandatory 64-char random string for HMAC-SHA256 session signature.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your_random_64_character_hex_secret_here

# Official primary and backup staff access PINs.
# These must ONLY be set in your secure deployment environment (e.g. Vercel Project Settings)
INTERNAL_STAFF_PIN=replace_with_strong_primary_pin
INTERNAL_BACKUP_PIN=replace_with_strong_backup_pin

# Optional: Custom password override for server staff accounts (defaults to server config if not set)
STAFF_PASSWORD=replace_with_secure_staff_password
# STAFF_DANNY_PASSWORD=custom_danny_password
# STAFF_ENGINEER_PASSWORD=custom_engineer_password

# --- 2. AI MODEL PROVIDERS ---
# Google Gemini API Key (get from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: Mode switch ('live' to use LLM, 'demo' for local deterministic engine)
SURTI_MODE=live

# Optional: Alternative OpenAI/Compatible Provider
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- 3. DATABASE (SUPABASE POSTGRESQL - PHASE 3) ---
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
