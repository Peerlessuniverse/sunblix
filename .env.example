# ============================================================================
# SUNBLIX WEB + SURTI AI — ENVIRONMENT VARIABLES
# ============================================================================
# Copy the relevant values into Coolify (Environment tab) or your local .env.
# NEVER commit real secrets to the repository.

# --- SUPABASE (required for persistent customer data capture) --------------
# Create a free project at https://supabase.com, then run both SQL migrations
# from supabase/migrations/ in the SQL Editor:
#   1. 20261018_surti_ai_schema.sql
#   2. 20261025_runtime_persistence.sql
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-from-project-settings-api>

# --- SURTI AI (optional: enables live AI instead of deterministic demo) ----
# Gemini (preferred) OR OpenAI-compatible:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- SURTI SERVICE KEY (akses CRM oleh asisten SURTI) ----------------------
# Kunci yang dapat dicabut, dipakai instance SURTI (Hermes/bot) untuk membaca
# dan menulis data CRM tanpa kredensial staf. Kirim via header: x-surti-key
# (atau Authorization: Bearer <key>). Minimal 24 karakter.
SURTI_CRM_API_KEY=surti-access-key-147797915017619382787261
# Rotation: while rolling a new key out to SURTI, put the old one here, then remove it.
# SURTI_CRM_API_KEY_PREVIOUS=
# Optional comma-separated IP allowlist (checked against nginx X-Real-IP).
# SURTI_ALLOWED_IPS=
# SURTI is private. The public chat page (/surti) and /api/surti/chat are
# CLOSED unless this is set to true.
# SURTI_PUBLIC_ENABLED=false
# Secret for signed public calculator links. Set a long random value in production.
# SURTI_PUBLIC_TOKEN_SECRET=<long-random-string>

# --- STAFF AUTH (DashboardOs /admin & CRM endpoints) ------------------------
# IMPORTANT: remove the insecure defaults in production!
AUTH_SECRET=<long-random-string>
INTERNAL_STAFF_PIN=<6-digit-pin>
INTERNAL_BACKUP_PIN=<6-digit-pin>
STAFF_PASSWORD=<strong-password>
STAFF_DANNY_PASSWORD=<strong-password>
STAFF_ADMIN_PASSWORD=<strong-password>

# --- PRODUCTION SAFETY ------------------------------------------------------
# Leave unset. Setting it allows destructive CRM resets even in production.
# ALLOW_PROD_DATA_RESET=true
